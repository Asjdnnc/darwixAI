# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
# Orpheus voices: autumn, diana, hannah (female); austin, daniel, troy (male)
GROQ_TTS_VOICE=austin

# Optional. Used for Philippines/Indonesia speech (Q3) and as an English TTS fallback.
OPENAI_API_KEY=
OPENAI_TTS_VOICE=ash

# Optional: POST lead / callback / escalation events to this URL (e.g. a webhook.site URL)
CRM_WEBHOOK_URL=

NUDGE_MIN_CONFIDENCE=0.75
